{
  "id": "pickle-nick",
  "name": "Pickle Nick",
  "domain": "picklenick.au",
  "template": "simple-website",
  "branding": {
    "name": "Pickle Nick",
    "color": "#10b981",
    "logo_url": null
  },
  "features": [
    "auth-clerk",
    "payments-stripe",
    "email-resend"
  ],
  "env": {
    "EMAIL_FROM": "hello@picklenick.au"
  },
  "secrets": [
    "CLERK_SECRET_KEY",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "RESEND_API_KEY"
  ]
}
