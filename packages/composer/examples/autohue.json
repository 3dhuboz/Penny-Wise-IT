{
  "id": "autohue",
  "name": "AutoHue",
  "domain": "autohue.steve-700.workers.dev",
  "template": "autohue",
  "branding": {
    "name": "AutoHue",
    "color": "#7c3aed"
  },
  "features": [
    "auth-bearer",
    "payments-stripe",
    "payments-paypal",
    "email-resend"
  ],
  "env": {
    "EMAIL_FROM": "licensing@autohue.app"
  },
  "secrets": [
    "JWT_SECRET",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "PAYPAL_CLIENT_ID",
    "PAYPAL_CLIENT_SECRET",
    "RESEND_API_KEY"
  ]
}
