{
  "id": "smokey-joes-bbq",
  "name": "Smokey Joe's BBQ",
  "domain": "smokeyjoes.com.au",
  "template": "food-truck",
  "branding": {
    "name": "Smokey Joe's BBQ",
    "color": "#dc2626"
  },
  "features": ["auth-clerk", "payments-stripe", "email-resend", "sms-twilio"],
  "env": {
    "EMAIL_FROM": "orders@smokeyjoes.com.au",
    "TWILIO_FROM_NUMBER": "+61400000000"
  },
  "secrets": [
    "CLERK_SECRET_KEY",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "RESEND_API_KEY",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN"
  ]
}
