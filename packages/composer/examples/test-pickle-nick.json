{
  "id": "pickle-nick",
  "name": "Pickle Nick's Emporium",
  "domain": "picklenick.com.au",
  "template": "simple-website",
  "branding": {
    "name": "Pickle Nick's Emporium",
    "color": "#65a30d"
  },
  "features": ["auth-clerk", "payments-square", "email-resend"],
