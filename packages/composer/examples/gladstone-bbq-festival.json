  "domain": "gladstonebbqfestival.com.au",
  "template": "festival",
  "branding": {
    "name": "Gladstone BBQ Festival",
    "color": "#b91c1c"
  },
  "features": ["auth-clerk", "payments-stripe", "email-resend", "sms-twilio"],
