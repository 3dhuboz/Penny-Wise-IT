# Google OAuth Client ID (get from https://console.cloud.google.com/apis/credentials)
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend API base URL (REQUIRED in production)
# Example: https://api.pennywiseit.com.au/api  (Cloudflare Worker on a custom domain)
# Local dev leaves this unset; the client falls back to http://localhost:5000/api
REACT_APP_API_URL=
