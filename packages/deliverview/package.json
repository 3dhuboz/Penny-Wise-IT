{
  "name": "@pennywiseit/deliverview",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "dev:frontend": "cd frontend && npm run dev",
    "deploy": "cd frontend && npm run build && cd .. && wrangler deploy",
    "db:migrate": "wrangler d1 execute deliverview-db --local --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute deliverview-db --remote --file=schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "@clerk/backend": "^1.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.0",
    "wrangler": "^3.0.0"
  }
}
